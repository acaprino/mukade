{
  "schema": "mukade.harness-catalog/1",
  "description": "The harnesses mukade reads and writes: how each one is launched, the canonical locations of its binary and store on Windows, macOS and Linux, the layout of its store, the lineage it records, and the resume command mukade returns.",
  "expansions": {
    "{home}": "USERPROFILE on Windows, HOME elsewhere",
    "{app_data}": "APPDATA (Windows only; a location using it is skipped elsewhere)",
    "{local_app_data}": "LOCALAPPDATA (Windows only; a location using it is skipped elsewhere)",
    "{xdg_data_home}": "XDG_DATA_HOME, else {home}/.local/share"
  },
  "harnesses": [
    {
      "id": "claude_code",
      "display": "Claude Code",
      "binary": {
        "name": "claude",
        "flag": "--claude-exe",
        "env": "MUKADE_CLAUDE_EXE",
        "locations": {
          "windows": ["{home}/.local/bin/claude.exe", "{home}/.local/bin/claude"],
          "macos": ["{home}/.local/bin/claude"],
          "linux": ["{home}/.local/bin/claude"]
        },
        "beside_store": {
          "windows": ["claude.exe", "bin/claude.exe", ".local/bin/claude.exe"],
          "macos": ["claude", "bin/claude", ".local/bin/claude"],
          "linux": ["claude", "bin/claude", ".local/bin/claude"]
        }
      },
      "store": {
        "env": "CLAUDE_CONFIG_DIR",
        "default": "{home}/.claude",
        "root_is_a_file": false,
        "layout": ["projects/<project>/<session-id>.jsonl"]
      },
      "lineage": {
        "recorded": true,
        "fields": ["forkedFrom"],
        "note": "a fork (/branch) names its origin session and row in forkedFrom on every row it copies; a subagent's transcript names its parent in sessionId and meta.json"
      },
      "resume": ["{exe}", "-p", "--resume", "{id}"],
      "interactive_resume": ["{exe}", "--resume", "{id}"]
    },
    {
      "id": "codex",
      "display": "Codex CLI",
      "binary": {
        "name": "codex",
        "flag": "--codex-exe",
        "env": "MUKADE_CODEX_EXE",
        "locations": {
          "windows": ["{local_app_data}/Programs/OpenAI/Codex/bin/codex.exe"],
          "macos": ["{home}/.local/bin/codex"],
          "linux": ["{home}/.local/bin/codex"]
        },
        "beside_store": {
          "windows": ["codex.exe", "bin/codex.exe"],
          "macos": ["codex", "bin/codex"],
          "linux": ["codex", "bin/codex"]
        }
      },
      "store": {
        "env": "CODEX_HOME",
        "default": "{home}/.codex",
        "root_is_a_file": false,
        "layout": ["sessions/<yyyy>/<mm>/<dd>/rollout-<stamp>-<thread-id>.jsonl", "session_index.jsonl"]
      },
      "lineage": {
        "recorded": true,
        "fields": ["forked_from_id", "parent_thread_id"],
        "note": "a fork names its origin thread in session_meta.forked_from_id; a subagent thread names the thread that spawned it (session_meta.parent_thread_id)"
      },
      "resume": ["{exe}", "exec", "resume", "{id}"],
      "interactive_resume": ["{exe}", "resume", "{id}"]
    },
    {
      "id": "opencode",
      "display": "OpenCode",
      "binary": {
        "name": "opencode",
        "flag": "--opencode-exe",
        "env": "MUKADE_OPENCODE_EXE",
        "locations": {
          "windows": ["{app_data}/npm/node_modules/@opencode/cli/bin/opencode.exe", "{app_data}/npm/opencode.cmd", "{home}/.opencode/bin/opencode.exe"],
          "macos": ["{home}/.opencode/bin/opencode"],
          "linux": ["{home}/.opencode/bin/opencode"]
        },
        "beside_store": {
          "windows": ["opencode.exe", "bin/opencode.exe", "resources/opencode-cli/opencode.exe", ".opencode/bin/opencode.exe", "opencode.cmd", "bin/opencode.cmd"],
          "macos": ["opencode", "bin/opencode", "resources/opencode-cli/opencode", ".opencode/bin/opencode"],
          "linux": ["opencode", "bin/opencode", "resources/opencode-cli/opencode", ".opencode/bin/opencode"]
        }
      },
      "store": {
        "env": "OPENCODE_DB",
        "default": "{xdg_data_home}/opencode/opencode.db",
        "root_is_a_file": true,
        "layout": ["opencode.db (SQLite; session_v2, session_message)"]
      },
      "lineage": {
        "recorded": true,
        "fields": ["parent_id", "fork_session_id", "fork_boundary"],
        "note": "a fork names its source session and the boundary it forked at"
      },
      "resume": ["{exe}", "run", "--standalone", "--session", "{id}"],
      "interactive_resume": ["{exe}", "mini", "--standalone", "--session", "{id}"]
    },
    {
      "id": "pi",
      "display": "Pi",
      "binary": {
        "name": "pi",
        "flag": "--pi-exe",
        "env": "MUKADE_PI_EXE",
        "locations": {
          "windows": ["{home}/.pi/agent/bin/pi.cmd", "{app_data}/npm/pi.cmd", "{app_data}/npm/pi"],
          "macos": ["{home}/.pi/agent/bin/pi"],
          "linux": ["{home}/.pi/agent/bin/pi"]
        },
        "beside_store": {
          "windows": ["bin/pi.cmd", "pi.cmd"],
          "macos": ["bin/pi", "pi"],
          "linux": ["bin/pi", "pi"]
        }
      },
      "store": {
        "env": "PI_CODING_AGENT_DIR",
        "default": "{home}/.pi/agent",
        "root_is_a_file": false,
        "layout": ["sessions/--<project>--/<stamp>_<session-id>.jsonl", "models.json"]
      },
      "lineage": {
        "recorded": true,
        "fields": ["parentSession"],
        "note": "the fork's session header names the session it came from"
      },
      "resume": ["{exe}", "-p", "--session", "{file}"],
      "interactive_resume": ["{exe}", "--session", "{file}"]
    },
    {
      "id": "hermes",
      "display": "Hermes Agent",
      "binary": {
        "name": "hermes",
        "flag": "--hermes-exe",
        "env": "MUKADE_HERMES_EXE",
        "locations": {
          "windows": ["{local_app_data}/hermes/bin/hermes.exe", "{local_app_data}/hermes/hermes-agent/.hermes/bin/hermes.exe"],
          "macos": ["{home}/.local/bin/hermes"],
          "linux": ["{home}/.local/bin/hermes"]
        },
        "beside_store": {
          "windows": ["bin/hermes.exe", "hermes-agent/.hermes/bin/hermes.exe"],
          "macos": ["bin/hermes"],
          "linux": ["bin/hermes"]
        }
      },
      "store": {
        "env": "HERMES_HOME",
        "default": "{home}/.hermes",
        "default_on": { "windows": "{local_app_data}/hermes" },
        "root_is_a_file": false,
        "layout": ["state.db (SQLite; sessions, messages)"]
      },
      "lineage": {
        "recorded": true,
        "fields": ["parent_session_id", "model_config._delegate_from", "model_config._branched_from"],
        "note": "a subagent names its parent in _delegate_from, a /branch copy in _branched_from"
      },
      "resume": ["{exe}", "chat", "-Q", "--resume", "{id}", "-q"],
      "interactive_resume": ["{exe}", "--resume", "{id}"]
    },
    {
      "id": "deepseek_harness",
      "display": "DeepSeek Harness",
      "binary": {
        "name": "dsh",
        "flag": "--dsh-exe",
        "env": "MUKADE_DSH_EXE",
        "locations": {
          "windows": ["{app_data}/npm/dsh.cmd"],
          "macos": [],
          "linux": []
        },
        "beside_store": {
          "windows": ["dsh.cmd", "bin/dsh.cmd"],
          "macos": ["dsh", "bin/dsh"],
          "linux": ["dsh", "bin/dsh"]
        }
      },
      "store": {
        "env": "DSH_HOME",
        "default": "{home}/.dsh",
        "root_is_a_file": false,
        "layout": ["sessions/--<project>--/<session-id>/session.v4.jsonl.zstd", "sessions/_no-cwd/<session-id>/session.v4.jsonl.zstd"]
      },
      "lineage": {
        "recorded": true,
        "fields": ["parentSession", "origin", "isSeeded"],
        "note": "a subagent or fork log names its parent in its header"
      },
      "resume": ["{exe}", "--profile", "headless", "--session-id", "{id}"]
    }
  ]
}
