{
  "name": "mukade",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "desktop": "cd apps/desktop && tauri dev",
    "desktop:build": "npm run build && cd apps/desktop && tauri build --debug --no-bundle",
    "desktop:release": "npm run build && cd apps/desktop && tauri build --no-bundle --features custom-protocol",
    "test": "node --experimental-strip-types --test apps/desktop/tests/*.test.ts",
    "smoke": "node apps/desktop/tests/smoke.mjs"
  },
  "dependencies": {
    "@acaprino/imago": "https://github.com/acaprino/imago/releases/download/v1.5.0/acaprino-imago-1.5.0.tgz",
    "@acaprino/sigrid": "https://github.com/acaprino/sigrid/releases/download/v6.21.2/acaprino-sigrid-6.21.2.tgz",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "imago": {
    "src": [
      "apps/desktop/src",
      "apps/desktop/index.html"
    ],
    "tests": [
      "apps/desktop/tests"
    ],
    "cargo": "apps/desktop/src-tauri/Cargo.toml",
    "agents": [
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "app": "mukade",
    "icons": {
      "apps/desktop/src-tauri/icons/32x32.png": "32x32.png",
      "apps/desktop/src-tauri/icons/128x128.png": "128x128.png",
      "apps/desktop/src-tauri/icons/128x128@2x.png": "256x256.png",
      "apps/desktop/src-tauri/icons/icon.png": "icon.png",
      "apps/desktop/src-tauri/icons/icon.ico": "icon.ico",
      "assets/windows/mukade.ico": "icon.ico"
    }
  }
}
